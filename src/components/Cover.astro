---
interface Props {
  src: string;
}

const { src } = Astro.props;
---

<img src={src} alt="" class="cover" />

<style>
  .cover {
    width: 100%;
    height: 140px;
    object-fit: cover;
    background-color: var(--color-border);
    display: block;
  }

  @media (max-width: 768px) {
    .cover {
      width: calc(100% + 2 * var(--space-lg));
      max-width: none;
      margin-left: calc(-1 * var(--space-lg));
    }
  }

  @media (min-width: 768px) {
    .cover {
      height: 200px;
    }
  }
</style>
