---
interface Props {
  text: string;
  limit?: number;
}

const { text, limit = 140 } = Astro.props;
const isLong = text.length > limit;
---

{isLong ? (
  <div class="readmore">
    <p class="readmore__text">{text}</p>
    <button type="button" class="readmore__toggle" data-readmore-toggle>... lainnya</button>
  </div>
) : (
  <p class="readmore__text">{text}</p>
)}

<style>
  .readmore__text {
    color: var(--color-text-secondary);
    font-size: var(--text-body);
    line-height: 1.7;
  }

  .readmore .readmore__text {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .readmore.is-expanded .readmore__text {
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  .readmore__toggle {
    margin-top: var(--space-xs);
    background: none;
    border: none;
    padding: 0;
    color: var(--color-text-primary);
    font-size: var(--text-caption);
    font-weight: 500;
    cursor: pointer;
    text-decoration: underline;
  }
</style>