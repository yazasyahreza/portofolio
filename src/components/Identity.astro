---
import type { IdentityData } from '../data/types';
import Cover from './Cover.astro';
import { resolveImageUrl } from '../lib/media';

interface Props {
  data: IdentityData;
}

const { data } = Astro.props;
---

<section class="identity">
  <div class="identity__cover-wrap">
    <Cover src={resolveImageUrl(data.coverImageUrl)} />
    <img src={resolveImageUrl(data.avatarUrl)} alt={`Foto profil ${data.name}`} class="identity__avatar" />
  </div>

  <div class="identity__content">
    <h1 class="identity__name">{data.name}</h1>
    <p class="identity__title">{data.title}</p>
    <p class="identity__location">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="identity__location-icon">
        <path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z"/>
        <circle cx="12" cy="10" r="2.5"/>
      </svg>
      {data.location}
    </p>
    <p class="identity__about-title">Who am I?</p>
    <p class="identity__about-text">{data.aboutText}</p>

    <div class="identity__skills">
      {data.skills.map((skill) => (
        <div class="identity__skill" title={skill.name}>
          <img src={`https://cdn.simpleicons.org/${skill.slug}/a3a3a3`} alt={skill.name} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .identity__cover-wrap {
    position: relative;
  }

  .identity__cover {
    width: 100%;
    height: 140px;
    object-fit: cover;
    background-color: var(--color-border);
  }

  .identity__avatar {
    position: absolute;
    bottom: -40px;
    left: var(--space-lg);
    width: 90px;
    height: 90px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--color-bg);
    display: block;
  }

  .identity__content {
    padding: var(--space-3xl) var(--space-lg) var(--space-lg);
  }

  @media (min-width: 768px) {
    .identity__cover {
      height: 200px;
    }

    .identity__avatar {
      bottom: -64px;
      left: var(--space-xl);
      width: 160px;
      height: 160px;
      border: 4px solid var(--color-bg);
    }

    .identity__content {
      padding: var(--space-5xl) var(--space-xl) var(--space-xl);
    }
  }

  .identity__name {
    font-size: var(--text-display);
    font-weight: 500;
  }

  .identity__title {
    font-size: var(--text-subtitle);
    color: var(--color-text-secondary);
  }

  .identity__location {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .identity__location-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .identity__about-title {
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
  }

  .identity__about-text {
    font-size: var(--text-body);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .identity__skills {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
  }

  .identity__skill {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-border-strong);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .identity__skill img {
    width: 18px;
    height: 18px;
  }
</style>