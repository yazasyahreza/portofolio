---
import type { ProjectItem } from '../data/types';
import ReadMore from './ReadMore.astro';
import { resolveImageUrl } from '../lib/media';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;

function formatDate(dateStr: string) {
  const [year, month] = dateStr.split('-');
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
  return `${months[parseInt(month, 10) - 1]} ${year}`;
}
---

<div class="project-card">
  <img src={resolveImageUrl(project.imageUrl)} alt={project.title} class="project-card__image" />

  <div class="project-card__body">   
    <h3 class="project-card__title">{project.title}</h3>
    <p class="project-card__date">{formatDate(project.builtDate)}</p>
    <div class="project-card__description">
      <ReadMore text={project.description} />
    </div>
    <ul class="project-card__skills">
      {project.techStack.map((t) => <li>{t}</li>)}
    </ul>
    
    
    <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="project-card__github">
      Lihat di GitHub →
    </a>
  </div>
</div>

<style>
  .project-card__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    display: block;
  }

  .project-card__body {
    margin-top: var(--space-lg);
  }

  .project-card__title {
    font-size: var(--text-subtitle);
    font-weight: 500;
  }

  .project-card__date {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    margin-top: var(--space-xs);
  }

  .project-card__description {
    margin-top: var(--space-md);
  }

  .project-card__skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    list-style: none;
    padding: 0;
    margin-top: var(--space-md);
  }

  .project-card__skills li {
    font-size: var(--text-caption);
    padding: 4px 10px;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    color: var(--color-text-secondary);
  }

  .project-card__github {
    display: inline-block;
    margin-top: var(--space-md);
    font-size: var(--text-caption);
    color: var(--color-text-primary);
    text-decoration: underline;
  }
</style>