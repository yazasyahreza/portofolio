---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Syahreza" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Personal portfolio of Syahreza, a developer interested in backend development and software engineering."
    />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>